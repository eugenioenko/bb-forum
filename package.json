{
  "name": "bb-client-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port=4200",
    "build": "next build",
    "start": "next start",
    "db": "docker-compose up -d",
    "lint": "next lint",
    "prisma:init": "prisma init",
    "prisma:generate": "prisma generate",
    "prisma:initialize": "prisma migrate dev --name initial",
    "prisma:migrate": "prisma migrate dev --preview-feature",
    "prisma:seed": "prisma db seed",
    "docker:build": "docker build --platform linux/amd64 -t eugenioenko/bbforum:latest .",
    "docker:clean": "docker stop bbforum && docker rm bbforum",
    "docker:push": "docker push eugenioenko/bbforum:latest",
    "docker:pull": "docker pull eugenioenko/bbforum:latest",
    "docker:deploy": "docker run -d -p 3000:3000 --restart unless-stopped --name bbforum eugenioenko/bbforum:latest",
    "test": "npx vitest",
    "test:headless": "npx vitest --run --browser.headless"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.16",
    "@hookform/resolvers": "^3.10.0",
    "@ngneat/falso": "^7.4.0",
    "@prisma/client": "^6.19.0",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^2.1.9",
    "arctic": "^2.3.4",
    "axios": "^1.13.2",
    "axios-cache-interceptor": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "dataloader": "^2.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.0.4",
    "jsdom": "^25.0.0",
    "jsonwebtoken": "^9.0.3",
    "msw": "^2.12.4",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "prisma-erd-generator": "^1.11.2",
    "react-hook-form": "^7.68.0",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
